# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com

# PostgreSQL (production platforms normally provide DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/nextstep_ai

# Tokens and security
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COUNSELOR_RATE=20/hour
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
LOG_LEVEL=INFO

# Optional SMTP email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NextStep AI <noreply@example.com>

